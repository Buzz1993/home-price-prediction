# ===============================
# EstateMind backend environment configuration
# ===============================
# Copy this file to `.env` and fill in the values.
# `.env` is gitignored and must never be committed.

# -------------------------------
# Anthropic Claude (explanation layer)
# -------------------------------
# Required to enable Claude. Without it, the Claude service returns a
# structured "missing_api_key" error instead of crashing the backend.
ANTHROPIC_API_KEY=

# Optional Claude configuration (safe defaults are used when unset).
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=1024
ANTHROPIC_TEMPERATURE=0.3
ANTHROPIC_TIMEOUT=60

# -------------------------------
# Meta WhatsApp Cloud API (report delivery, Phase 16.1)
# -------------------------------
# Required to send reports over WhatsApp (POST /report/share). Without them,
# sharing returns a clear "not configured" error; report generation and
# preview keep working. Get both values from the Meta developer dashboard
# (WhatsApp > API Setup).
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_API_VERSION=v25.0

# -------------------------------
# Report PDF rendering (Phase 16.2)
# -------------------------------
# Base URL of the running Next.js frontend. Headless Chromium opens
# {FRONTEND_BASE_URL}/print/report to export the report PDF used by both
# Export PDF and WhatsApp delivery. Defaults to http://localhost:3000.
FRONTEND_BASE_URL=http://localhost:3000

# -------------------------------
# Ollama LLM backend (src/llm/deepseek_client.py)
# -------------------------------
# Defaults target the local Ollama daemon, so nothing is required locally.
# For production (Railway) point at the hosted Ollama Cloud API and supply
# an API key from https://ollama.com/settings/keys:
#   OLLAMA_URL=https://ollama.com/api/generate
#   OLLAMA_MODEL=gpt-oss:120b
#   OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_API_KEY=
